// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Adjust to "mysql" if you are not using Postgres
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPERADMIN
  ADMIN
  GURU
  SISWA
}

enum TipeSoal {
  MCQ
  ESSAY
}

enum StatusUjian {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
}

enum JobStatus {
  PENDING
  PROCESSING_PDF
  GENERATING_QUESTIONS
  DONE
  FAILED
}

// ==========================================
// USERS & TENANCY
// ==========================================

model Sekolah {
  id          Int      @id @default(autoincrement())
  namaSekolah String   @map("nama_sekolah")
  alamat      String?  @db.Text

  users       User[]
  kelas       Kelas[]

  @@map("sekolah")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role

  sekolahId Int?     @map("sekolah_id") // Nullable for Superadmins
  sekolah   Sekolah? @relation(fields: [sekolahId], references: [id])

  keanggotaan KelasMember[]
  bukuDibuat  Buku[]
  ujianDibuat Ujian[]
  sesiUjian   SesiUjianSiswa[]

  kelasDiajar Kelas[]          @relation("GuruKelas")

  @@map("users")
}

model Kelas {
  id        Int      @id @default(autoincrement())
  namaKelas String   @map("nama_kelas")
  
  sekolahId Int      @map("sekolah_id")
  sekolah   Sekolah  @relation(fields: [sekolahId], references: [id])

  teacherId   Int      @map("teacher_id")
  teacher     User     @relation("GuruKelas", fields: [teacherId], references: [id])

  members     KelasMember[]
  jadwalUjian JadwalUjian[]

  @@map("kelas")
}

model KelasMember {
  kelasId Int   @map("kelas_id")
  userId  Int   @map("user_id")

  kelas   Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([kelasId, userId]) // Composite Primary Key
  @@map("keanggotaan_kelas")
}

// ==========================================
// CONTENT BANK
// ==========================================

model Buku {
  id      Int    @id @default(autoincrement())
  judul   String
  
  guruId  Int    @map("guru_id")
  guru    User   @relation(fields: [guruId], references: [id])

  bab     Bab[]

  jobs     GenerationJob[]

  @@map("buku")
}

model GenerationJob {
  id           Int       @id @default(autoincrement())
  status       JobStatus @default(PENDING)
  fileName     String    @map("file_name")
  fileUrl      String?   @map("file_url") // Bisa diset null/dihapus kalau file lokal sudah di-unlink
  errorMessage String?   @map("error_message") @db.Text
  jumlahSoal   Int       @default(10) @map("jumlah_soal")
  tokensSpent  Int       @default(0) @map("tokens_spent")

  bukuId       Int       @map("buku_id")
  buku         Buku      @relation(fields: [bukuId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  @@map("generation_job")
}

model Bab {
  id       Int    @id @default(autoincrement())
  judulBab String @map("judul_bab")
  
  bukuId   Int    @map("buku_id")
  buku     Buku   @relation(fields: [bukuId], references: [id], onDelete: Cascade)

  learningGoals String?   @map("learning_goals") @db.Text // Hasil ekstraksi Gemini disimpan di sini

  soal     BankSoal[]
  ujianBab     UjianBab[]

  @@map("bab")
}

model BankSoal {
  id               Int      @id @default(autoincrement())
  teksSoal         String   @map("teks_soal") @db.Text
  opsiJawaban      Json?    @map("opsi_jawaban")
  jawabanBenarMcq  String?  @map("jawaban_benar_mcq")
  type             TipeSoal

  babId            Int      @map("bab_id")
  bab              Bab      @relation(fields: [babId], references: [id], onDelete: Cascade)

  jawabanSiswa     JawabanSiswa[]

  difficulty Int
  bloomLevel String?

  @@map("bank_soal")
}

// ==========================================
// EXAM TEMPLATES & SCHEDULING
// ==========================================

model TipeUjian {
  id            Int    @id @default(autoincrement())
  namaTipeUjian String @map("nama_tipe_ujian")

  jadwalUjian   JadwalUjian[]

  @@map("tipe_ujian")
}

model Ujian {
  id              Int      @id @default(autoincrement())

  judulUjian      String   @map("judul_ujian")
  durasiMenit     Int      @map("durasi_menit")
  jumlahSoal      Int      @map("jumlah_soal")

  isAdaptive      Boolean  @default(true)
  isLocked        Boolean  @default(false)

  guruId          Int      @map("guru_id")
  guru            User     @relation(fields: [guruId], references: [id])

  jadwalUjian     JadwalUjian[]
  ujianBab        UjianBab[]
  criteria        UjianCriteria?

  @@map("ujian")
}

model UjianBab {
  ujianId Int
  babId   Int

  ujian Ujian @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  bab   Bab   @relation(fields: [babId], references: [id], onDelete: Cascade)

  @@id([ujianId, babId])
  @@map("ujian_bab")
}

model JadwalUjian {
  id                 Int         @id @default(autoincrement())
  waktuMulaiAktif    DateTime?   @map("waktu_mulai_aktif")
  waktuSelesaiAktif  DateTime?   @map("waktu_selesai_aktif")
  status             StatusUjian @default(DRAFT)

  ujianId            Int         @map("ujian_id")
  kelasId            Int         @map("kelas_id")
  tipeUjianId        Int         @map("tipe_ujian_id")

  ujian              Ujian       @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  kelas              Kelas       @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  tipeUjian          TipeUjian   @relation(fields: [tipeUjianId], references: [id])

  sesiSiswa          SesiUjianSiswa[]

  @@map("jadwal_ujian")
}

// ==========================================
// STUDENT INTERACTION & AI LOGS
// ==========================================

model SesiUjianSiswa {
  id            Int       @id @default(autoincrement())
  waktuMulai    DateTime  @default(now()) @map("waktu_mulai")
  waktuSelesai  DateTime? @map("waktu_selesai")
  nilaiAkhir    Float?    @map("nilai_akhir")

  currentElo    Float     @default(1000.0) @map("current_elo")

  jadwalUjianId Int       @map("jadwal_ujian_id")
  siswaId       Int       @map("siswa_id")

  jadwalUjian   JadwalUjian @relation(fields: [jadwalUjianId], references: [id], onDelete: Cascade)
  siswa         User        @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  jawabanSiswa  JawabanSiswa[]
  aiLogs        SavedResponses[]

  @@map("sesi_ujian_siswa")
}

model JawabanSiswa {
  id               Int      @id @default(autoincrement())

  // Snapshot
  soalAsliId       Int?     @map("soal_asli_id")

  nomor            Int

  teksSoal         String   @map("teks_soal") @db.Text
  opsiJawaban      Json?    @map("opsi_jawaban")
  jawabanBenarMcq  String?  @map("jawaban_benar_mcq")
  type             TipeSoal

  // Student answer
  jawabanSiswa     String?  @map("jawaban_siswa") @db.Text
  isCorrect        Boolean? @map("is_correct")

  nilaiPoin        Float?   @map("nilai_poin")
  catatanKoreksi   String?  @map("catatan_koreksi") @db.Text

  answeredAt       DateTime? @map("answered_at")

  eloBefore        Float?   @map("elo_before")
  eloAfter         Float?   @map("elo_after")

  attemptId        Int       @map("attempt_id")

  attempt          SesiUjianSiswa @relation(fields: [attemptId],references: [id],onDelete: Cascade)

  soalAsli         BankSoal? @relation(fields: [soalAsliId],references: [id],onDelete: SetNull)

  difficulty Int
  bloomLevel String?
  @@map("jawaban_siswa")
}

model TaskQueue {
  id          Int      @id @default(autoincrement())
  type        String   // "extract_pdf", "generate_report", etc.
  status      String   @default("pending") // "pending", "processing", "completed", "failed"
  payload     Json     // Stores context (e.g., attemptId, summarized history)
  
  provider    String?  // The LLM assigned (e.g., "claude", "gemini", "groq")
  attempts    Int      @default(0)
  errorLog    String?  @db.Text
  tokensSpent Int      @default(0) @map("tokens_spent")
  
  lockedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("task_queue")
}


model SavedResponses {
  id             Int            @id @default(autoincrement())
  
  // Replaced aiStatementSummary with specific sections
  overview       String?        @db.Text
  weakness       String?        @db.Text
  recommendation String?        @db.Text
  
  status         String         @default("PENDING") // "PENDING", "COMPLETED", "FAILED"
  createdAt      DateTime       @default(now()) @map("created_at")

  attemptId      Int            @unique @map("attempt_id")
  attempt        SesiUjianSiswa @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("saved_responses")
}

model UjianCriteria {
  id       Int   @id @default(autoincrement())
  ujianId  Int   @unique @map("ujian_id")
  ujian    Ujian @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  reqC1    Int   @default(10) @map("req_c1")
  reqC2    Int   @default(10) @map("req_c2")
  reqC3    Int   @default(10) @map("req_c3")
  reqC4    Int   @default(10) @map("req_c4")

  @@map("ujian_criteria")
}
